# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_WHATSAPP: Nomor WhatsApp Admin Warung Babi Ngepet (format internasional 62...)
ADMIN_WHATSAPP="6287716443331"

# ADMIN_PASSCODE: Passcode login untuk Kasir Admin (opsional; jika kosong, atur lewat form setup pertama kali)
ADMIN_PASSCODE=

# Opsional: Endpoint WhatsApp Gateway (mis. Fonnte / Wablas / Meta Cloud API webhook)
# Jika diisi, server akan otomatis mengirim notifikasi pesanan baru ke WhatsApp Admin via API.
WHATSAPP_GATEWAY_URL=""
WHATSAPP_GATEWAY_TOKEN=""
